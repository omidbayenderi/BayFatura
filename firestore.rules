rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'omidbayenderi@gmail.com';
    }

    function userEditableKeys() {
      return [
        'name',
        'companyName',
        'email',
        'avatar',
        'phone',
        'address',
        'city',
        'country',
        // Company profile fields edited from Settings.
        'owner',
        'companyEmail',
        'companyPhone',
        'website',
        'taxId',
        'vatId',
        'street',
        'houseNum',
        'zip',
        'bankName',
        'iban',
        'bic',
        'logo',
        'signature',
        'signatureUrl',
        'stamp',
        'stampUrl',
        'paymentTerms',
        'industry',
        'industryData',
        'logoDisplayMode',
        'kleinunternehmer',
        'kleinunternehmerText',
        'defaultCurrency',
        'defaultTaxRate',
        'paypalMe',
        'stripeLink',
        'atValidationCode',
        'invoiceSeries',
        'ptQrEnabled',
        'ptDocType',
        'language',
        'stripePublicKey',
        'paypalClientId'
      ];
    }

    function isSafeUserCreate(userId) {
      return request.resource.data.keys().hasOnly([
          'name',
          'companyName',
          'email',
          'plan',
          'role',
          'tenantId',
          'createdAt'
        ])
        && request.resource.data.tenantId == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.plan == 'standard'
        // Ordinary accounts are owners of their own workspace, never admins.
        // The only platform-admin profile may be bootstrapped by its Firebase
        // Auth identity during the initial sign-in.
        && (
          request.resource.data.role == 'owner' ||
          (request.auth.token.email == 'omidbayenderi@gmail.com' && request.resource.data.role == 'admin')
        );
    }

    function isSafeUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userEditableKeys())
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
    }

    function keepsOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    // =============================
    // Users
    // =============================

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (request.auth.uid == userId && isSafeUserCreate(userId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (request.auth.uid == userId && isSafeUserUpdate())
      );
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // =============================
    // Customers
    // =============================

    match /customers/{docId} {
      allow read, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && keepsOwner()) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        get(/databases/$(database)/documents/customers/$(docId)).data.userId == request.auth.uid || 
        isSuperAdmin()
      );
    }

    // =============================
    // Products
    // =============================

    match /products/{docId} {
      allow read, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && keepsOwner()) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
    }

    // =============================
    // Invoices
    // =============================

    match /invoices/{docId} {
      allow read, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && keepsOwner()) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
    }

    // =============================
    // Quotes
    // =============================

    match /quotes/{docId} {
      allow read, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && keepsOwner()) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
    }

    // =============================
    // Expenses
    // =============================

    match /expenses/{docId} {
      allow read, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && keepsOwner()) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
    }

    // =============================
    // Recurring Templates
    // =============================

    match /recurring_templates/{docId} {
      allow read, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && keepsOwner()) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
    }

    // =============================
    // Bank Matches
    // =============================

    match /bankMatches/{docId} {
      allow read, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && keepsOwner()) || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
    }

    // =============================
    // Customizations
    // =============================

    match /customizations/{orgId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == orgId || isSuperAdmin()
      );
    }

    // =============================
    // Feature Flag Configuration
    // =============================

    match /app_config/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    match /company_config/{orgId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == orgId ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/myTeams/$(orgId)) ||
        isSuperAdmin()
      );
      allow create, update, delete: if isSuperAdmin();
    }

    // =============================
    // Audit Logs
    // =============================

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() && request.resource.data.adminEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    // =============================
    // SEO Agent Data (server-managed, SuperAdmin read)
    // =============================

    match /seo_content_queue/{docId} {
      allow read: if isSuperAdmin() || (
        resource.data.type == 'programmatic_page' &&
        resource.data.status in ['ready_to_publish', 'published']
      );
      allow create, update, delete: if false;
    }

    match /seo_opportunities/{docId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /seo_reports/{docId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /seo_rankings/{docId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /seo_tasks/{docId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // =============================
    // Notifications (Subcollection of Users)
    // =============================

    match /users/{userId}/notifications/{docId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // =============================
    // Team (Subcollection of Users)
    // =============================

    match /users/{userId}/team/{memberId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // =============================
    // Invites (Subcollection of Users)
    // =============================

    match /users/{userId}/invites/{inviteId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // =============================
    // Joined Teams (server-managed)
    // =============================

    match /users/{userId}/myTeams/{teamId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // =============================
    // Rate Limits (server-managed, no client access)
    // =============================

    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // =============================
    // Email Logs (server-managed, SuperAdmin read)
    // =============================

    match /email_logs/{docId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Editorial content can only be managed by the platform owner.
    match /admin_blog_posts/{postId} {
      allow read, write: if isSuperAdmin();
    }

    // =============================
    // Default Deny
    // =============================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
